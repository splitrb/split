<% experiment.calc_winning_alternatives if Split.configuration.dashboard_calculate_winning_alternatives %>
<%
  experiment_class = goal.nil? ? "experiment" : "experiment experiment_with_goal"
  experiment_goal_class = "experiment-#{index}"

  view = Split::DashboardExperiment.new(experiment, goal)
%>


<div class="<%= experiment_class %>" data-name="<%= experiment.name %>" data-complete="<%= experiment.has_winner? %>">
  <div class="experiment-header">
    <h2>
      Experiment: <%= experiment.name %>
      <% if experiment.version > 1 %><span class='version'>v<%= experiment.version %></span><% end %>
      <% unless goal.nil? %><span class='goal'>Goal:<%= goal %></span><% end %>
      <% metrics = @metrics.select {|metric| metric.experiments.include? experiment} %>
      <% unless metrics.empty? %>
        <span class='goal'>Metrics:<%= metrics.map(&:name).join(', ') %></span>
      <% end %>
    </h2>

    <% if goal.nil? %>
      <div class='inline-controls'>
        <small><%= experiment.start_time ? experiment.start_time.strftime('%Y-%m-%d') : 'Unknown' %></small>
        <%= erb :_controls, :locals => {:experiment => experiment} %>
      </div>
    <% end %>
  </div>
  <table>
    <tr>
      <th>Alternative Name</th>
      <th>Participants</th>
      <th>Non-finished</th>
      <th>Completed</th>
      <th>Conversion Rate</th>
      <% view.extra_columns.each do |column| %>
        <th><%= column %></th>
      <% end %>
      <th>
        <select id="dropdown-<%= experiment_goal_class %>" name="dropdown-<%= experiment_goal_class %>">
          <option value="confidence-<%= experiment_goal_class %>">Confidence</option>
          <option value="probability-<%= experiment_goal_class %>">Probability of being Winner</option>
        </select>
      </th>
      <th>Finish</th>
    </tr>

    <% view.alternatives.each do |alternative| %>
      <tr>
        <td>
          <%= alternative.name %>
          <% if alternative.control? %>
            <em>control</em>
          <% end %>
          <form action="<%= url('force_alternative') + '?experiment=' + experiment.name %>" method='post'>
            <input type='hidden' name='alternative' value='<%= h alternative.name %>'>
            <input type="submit" value="Force for current user" class="green">
          </form>
        </td>
        <td><%= alternative.participants %></td>
        <td><%= alternative.unfinished %></td>
        <td><%= alternative.completed %></td>
        <td>
          <%= number_to_percentage(alternative.conversion_rate) %>%
          <% if (delta = alternative.conversion_delta) %><span class="<%= delta > 0 ? "better" : "worse" %>"><%= "+" if delta > 0 %><%= number_to_percentage(delta) %>%</span><% end %>
        </td>
        <% view.extra_columns.each do |column| %>
          <td><%= alternative.extra_info[column] %></td>
        <% end %>
        <td>
          <div class="box-<%= experiment_goal_class %> confidence-<%= experiment_goal_class %>">
            <span title='z-score: <%= round(alternative.z_score, 3) %>'><%= confidence_level(alternative.z_score) %></span>
            <br>
          </div>
          <div class="box-<%= experiment_goal_class %> probability-<%= experiment_goal_class %>">
            <span title="p_winner: <%= round(alternative.p_winner, 3) %>"><%= number_to_percentage(round(alternative.p_winner, 3)) %>%</span>
          </div>
        </td>
        <td>
          <% if experiment.has_winner? %>
            <% if alternative.winner? %>
              Winner
            <% else %>
              Loser
            <% end %>
          <% else %>
            <form action="<%= url('experiment') + '?experiment=' + experiment.name %>" method='post' data-confirm="This will now be returned for all users. Are you sure?">
              <input type='hidden' name='alternative' value='<%= h alternative.name %>'>
              <input type="submit" value="Use this" class="green">
            </form>
          <% end %>
        </td>
      </tr>

    <% end %>

    <tr class="totals">
      <td>Totals</td>
      <td><%= view.total_participants %></td>
      <td><%= view.total_unfinished %></td>
      <td><%= view.total_completed %></td>
      <td>N/A</td>
      <% view.extra_totals.each_value do |total| %>
        <td><%= total %></td>
      <% end %>
      <td>N/A</td>
      <td>N/A</td>
    </tr>
  </table>
</div>

<% overrides = active_overrides %>
<% unless overrides.empty? %>
  <div class="overrides">
    <div class="overrides-header">
      <h2>Overrides active in this browser</h2>
      <form action="<%= url "/clear_overrides" %>" method='post'>
        <input type="submit" value="Clear all" class="red">
      </form>
    </div>

    <p class="overrides-intro">
      These pin <strong>your own</strong> visits to a fixed alternative. Other users are unaffected.
      <% if Split.configuration.store_override %>
        Your visits are still counted as participants.
      <% else %>
        Your visits are <strong>not counted</strong> as participants, so these experiments can read
        zero below even though the page rendered an alternative for you.
      <% end %>
    </p>

    <ul class="overrides-list">
      <% overrides.sort.each do |experiment_name, alternative_name| %>
        <li>
          <span class="overrides-pair">
            <%= h experiment_name %> &rarr; <strong><%= h alternative_name.to_s %></strong>
          </span>
          <form action="<%= url "/clear_override" %>" method='post'>
            <input type='hidden' name='experiment' value='<%= h experiment_name %>'>
            <input type="submit" value="Clear" class="red">
          </form>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @experiment_names.any? %>
  <p class="intro">The list below contains all the registered experiments along with the number of test participants, completed and conversion rate currently in the system.</p>

  <div class="dashboard-controls">
    <input type="text" placeholder="Begin typing to filter" id="filter" />
    <input type="button" id="toggle-completed" value="Hide completed" />
    <input type="button" id="toggle-active" value="Hide active" />
    <input type="button" id="clear-filter" value="Clear filters" />
  </div>

  <% @experiments.each_with_index do |experiment, index| %>
    <% if experiment.goals.empty? %>
      <%= erb :_experiment, :locals => {:goal => nil, :experiment => experiment, :index => index} %>
    <% else %>
      <%= erb :_experiment_with_goal_header, :locals => {:experiment => experiment} %>
      <% experiment.goals.each_with_index do |g, goal_index| %>
        <%= erb :_experiment, :locals => {:goal => g, :experiment => experiment, :index => "#{index}-#{goal_index}"} %>
      <% end %>
    <% end %>
  <% end %>

  <div class="pagination">
    <%= pagination(@experiment_names) %>
  </div>
<% else %>
  <p class="intro">No experiments have started yet, you need to define them in your code and introduce them to your users.</p>
  <p class="intro">Check out the <a href='https://github.com/splitrb/split#readme'>Readme</a> for more help getting started.</p>
<% end %>

<div class="dashboard-controls dashboard-controls-bottom">
  <form action="<%= url "/initialize_experiment" %>" method='post'>
    <label>Add unregistered experiment: </label>
    <select name="experiment" id="experiment-select">
      <option selected disabled>experiment</option>
      <% @unintialized_experiments.sort.each do |experiment_name| %>
          <option value="<%= experiment_name %>"><%= experiment_name %></option>
      <% end %>
    </select>
    <input type="submit" id="register-experiment-btn" value="register experiment"/>
  </form>
<div>
